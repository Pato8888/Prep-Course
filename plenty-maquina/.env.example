# Copiá este archivo a .env y completá las claves. NUNCA subas .env a GitHub.
ANTHROPIC_API_KEY=
APIFY_TOKEN=
OPENAI_API_KEY=            # solo para transcribir (Whisper)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=       # voz en español rioplatense elegida en ElevenLabs
META_ACCESS_TOKEN=         # token de larga duración de la página de Plenty
META_IG_USER_ID=           # ID de la cuenta de Instagram profesional
META_PAGE_ID=              # ID de la página de Facebook
TIKTOK_ACCESS_TOKEN=       # Content Posting API (requiere app aprobada)
